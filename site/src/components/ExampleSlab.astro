---
import { Code } from "astro:components";
import Meter from "./Meter.astro";

const example = `// 50,000 text messages a month, and not one more.
const sms = hh.group("sms")
  .budget("messages", { limit: 50_000, renewal: renewal.monthly() });

// Sending to 200 people. Can we afford it?
const result = await sms
  .draw("messages", 200)
  .charge();`;
---

<div class="slab">
  <div class="slab-code">
    <div class="slab-label">sms.charge(…)</div>
    <Code code={example} lang="ts" theme="css-variables" />
  </div>

  <div>
    <div class="status">
      <span class="status-code">402</span>
      <span class="status-text">budget_exceeded</span>
    </div>

    <Meter
      name="messages"
      used={49880}
      limit={50000}
      display="49,880 / 50,000"
      exceeded
      keepDisplay
    />

    <p class="verdict">
      <strong>Only 120 left, so the answer is no.</strong> Nothing was spent, and
      the budget is untouched. Retry in 12d.
    </p>
  </div>
</div>
