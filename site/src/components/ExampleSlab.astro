---
import { Code } from "astro:components";
import Meter from "./Meter.astro";

const example = `// A Cloud SMS provider
const sms = hh.group("sms")
  .budget("messages", { limit: 50_000, renewal: renewal.monthly() })
  .budget("segments", { limit: 100_000, renewal: renewal.monthly() });

// A 3-segment blast to 12,000 phones against
// a segment budget with 880 left.
const result = await sms
  .draw("messages", 12_000)
  .draw("segments", 36_000)
  .idempotent("blast-51ac")
  .charge();`;
---

<div class="slab">
  <div class="slab-code">
    <div class="slab-label">sms.charge(…)</div>
    <Code code={example} lang="ts" theme="css-variables" />
  </div>

  <div>
    <div class="status">
      <span class="status-code">402</span>
      <span class="status-text">budget_exceeded</span>
    </div>

    <Meter
      name="messages"
      used={18204}
      limit={50000}
      display="18,204 / 50,000"
    />
    <Meter
      name="segments"
      used={99120}
      limit={100000}
      display="99,120 / 100,000"
      exceeded
    />

    <p class="verdict">
      <strong>Nothing was spent.</strong> Not on the budget that ran out, and not
      on the one that had room. Retry in 12d.
    </p>
  </div>
</div>
